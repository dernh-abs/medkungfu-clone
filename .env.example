# ============================================================================
# MedKungFu — 环境变量示例 (ENVIRONMENT VARIABLES TEMPLATE)
# ----------------------------------------------------------------------------
# 本文件是「模板」，不会被 Next.js 自动加载。用途：
#   1) 提交到仓库，作为团队/部署平台的环境变量「清单与说明」。
#   2) 复制为本地真实环境文件后再填写：
#        cp .env.example .env.local        # 本地（已被 .gitignore 忽略，不会入库）
#   3) 在部署平台（Vercel / CloudBase / 自有服务器）的「预览(Preview)环境」
#      变量设置里，按需填写下面这些变量即可。
#
# 注意：只有 NEXT_PUBLIC_ 前缀的变量会被打包进客户端（浏览器）代码，
#       其余变量仅在服务端（Node / API Route）可用。
# ============================================================================

# ----------------------------------------------------------------------------
# 悬浮「进入 Studio」编辑按钮 (StudioFab)
# ----------------------------------------------------------------------------
# 控制右下角悬浮按钮是否在页面上显示。该按钮一键跳转到对应页面的 Studio 编辑器。
#
# 显示逻辑（见 src/components/StudioFab.tsx）：
#   - 本地开发 (NODE_ENV !== "production")：始终显示，无需设置此变量。
#   - 生产构建 (NODE_ENV === "production")：默认【隐藏】；只有本变量为 "true" 才显示。
#
# 为什么方便预览部署？
#   预览/预发环境通常是「生产构建」(NODE_ENV=production)，按钮默认不出现。
#   在部署平台的「Preview 环境」变量里把本变量设为 true，就能让评审/内容同事
#   在预览站点上直接点按钮进 Studio 改内容——无需知道 /studio 路径、也无需另起 dev。
#   而正式生产环境不设置（或设为 false），按钮自动隐藏，不会把编辑器入口暴露给公众。
#
# 取值：true | false（不设置 = 生产环境隐藏）
NEXT_PUBLIC_SHOW_STUDIO_FAB=true

# ----------------------------------------------------------------------------
# 内容存储模式 (Content Mode)
# ----------------------------------------------------------------------------
# local  = 内容读写本地 .content/ 目录（默认，适合开发/预览/自托管）
# remote = 内容走远端契约存储（需自行实现 remote 适配器）
CONTENT_MODE=local

# ----------------------------------------------------------------------------
# LLM / 自然语言指令 (Studio NL commands)
# ----------------------------------------------------------------------------
# 是否启用真实大模型（Studio 里的「用中文改内容」指令）：
#   true  = 调用下方 LLM_* 配置的真实模型
#   false / 不设置 = mock 模式（不消耗额度，仅返回结构化计划，适合演示/预览）
ENABLE_LLM=false

# 以下仅在 ENABLE_LLM=true 时需要填写
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=

# ----------------------------------------------------------------------------
# 版本快照 (Version Store)
# ----------------------------------------------------------------------------
# 每多少次写操作做一次快照（默认 50）
SNAPSHOT_INTERVAL=50
# 是否启用快照优化（默认 false）
SNAPSHOT_OPTIMIZATION=false
