 r=\"4\"></circle><path d=\"M22 21v-2a4 4 0 0 0-3-3.87\"></path><path d=\"M16 3.13a4 4 0 0 1 0 7.75\"></path></svg></div><h3 class=\"text-xl font-bold text-[#1A1A2E] mb-2\">Jiang Guoliang</h3><p class=\"text-blue-600 font-medium mb-3\">Honorary Director</p><p class=\"text-gray-600 text-sm whitespace-pre-line\">Hospital Honorary Director</p></div></div><div class=\"space-y-12\"><div class=\"bg-white rounded-2xl p-8 shadow-sm\" style=\"opacity: 0; transform: translateY(20px);\"><h3 class=\"text-2xl font-bold text-[#1A1A2E] mb-6 pb-4 border-b border-gray-200\">Head &amp; Neck / CNS Oncology</h3><div class=\"grid md:grid-cols-2 gap-6 mb-6\"><div class=\"bg-blue-50 rounded-xl p-6\"><div class=\"mb-4 flex items-start gap-4\"><div class=\"flex h-16 w-16 flex-shrink-0 items-center justify-center rounded-full bg-gradient-to-br from-blue-600 to-indigo-600 text-xl font-bold text-white shadow-sm\" aria-hidden=\"true\">K</div><div><h4 class=\"font-bold text-blue-700 mb-1\">Kong Lin</h4><p class=\"text-sm text-gray-600\">Chief Physician, PhD Supervisor</p></div></div><p class=\"text-sm text-gray-700 whitespace-pre-line\">Assistant to President, Director of Head &amp; Neck Oncology Dept I\nChairman of Proton Heavy Ion Radiotherapy Committee\nTeam completed over 4,000 particle therapy cases\nInternational pioneer in mixed beam radiotherapy for nasopharyngeal cancer, won 61st PTCOG \"Goitein Award\"</p></div><div class=\"bg-blue-50 rounded-xl p-6\"><div class=\"mb-4 flex items-start gap-4\"><div class=\"flex h-16 w-16 flex-shrink-0 items-center justify-center rounded-full bg-gradient-to-br from-blue-600 to-indigo-600 text-xl font-bold text-white shadow-sm\" aria-hidden=\"true\">H</div><div><h4 class=\"font-bold text-blue-700 mb-1\">Hu Chaosu</h4><p class=\"text-sm text-gray-600\">Chief Physician, PhD Supervisor</p></div></div><p class=\"text-sm text-gray-700 whitespace-pre-line\">Director of Head &amp; Neck Oncology Dept II\nDirector of Fudan Nasopharyngeal Cancer Center\nTeam treated over 1,000 particle therapy patients</p></div></div><div><h4 class=\"font-medium text-gray-700 mb-3\">Department Core Members</h4><div class=\"grid md:grid-cols-2 lg:grid-cols-3 gap-3\"><div class=\"flex items-center gap-2 text-sm text-gray-600\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-check-circle text-blue-600\"><path d=\"M22 11.08V12a10 10 0 1 1-5.93-9.14\"></path><path d=\"m9 11 3 3L22 4\"></path></svg><span>Hu Weixu, Associate Chief Physician</span></div><div class=\"flex items-center gap-2 text-sm text-gray-600\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-check-circle text-blue-600\"><path d=\"M22 11.08V12a10 10 0 1 1-5.93-9.14\"></path><path d=\"m9 11 3 3L22 4\"></path></svg><span>Hu Jiyi, Chief Physician</span></div></div></div></div><div class=\"bg-white rounded-2xl p-8 shadow-sm\" style=\"opacity: 0; transform: translateY(20px);\"><h3 class=\"text-2xl font-bold text-[#1A1A2E] mb-6 pb-4 border-b border-gray-200\">Thoracic Oncology</h3><div class=\"grid md:grid-cols-2 gap-6 mb-6\"><div class=\"bg-blue-50 rounded-xl p-6\"><div class=\"mb-4 flex items-start gap-4\"><div class=\"flex h-16 w-16 flex-shrink-0 items-center justify-center rounded-full bg-gradient-to-br from-blue-600 to-indigo-600 text-xl font-bold text-white shadow-sm\" aria-hidden=\"true\">W</div><div><h4 class=\"font-bold text-blue-700 mb-1\">Wu Kailiang</h4><p class=\"text-sm text-gray-600\">Chief Physician, PhD Supervisor</p></div></div><p class=\"text-sm text-gray-700 whitespace-pre-line\">Assistant to President, Director of Thoracic Oncology\nVice Chairman of Ion Radiation Therapy Branch\nTeam pioneered large-scale pencil beam scanning for lung cancer\nInternationally established dose fractionation protocols for thoracic heavy ion therapy</p></div></div><div><h4 class=\"font-medium text-gray-700 mb-3\">Department Core Members</h4><div class=\"grid md:grid-cols-2 lg:grid-cols-3 gap-3\"><div class=\"flex items-center gap-2 text-sm text-gray-600\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-check-circle text-blue-600\"><path d=\"M22 11.08V12a10 10 0 1 1-5.93-9.14\"></path><path d=\"m9 11 3 3L22 4\"></path></svg><span>Mao Jingfang, Chief Physician, Deputy Director</span></div><div class=\"flex items-center gap-2 text-sm text-gray-600\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-check-circle text-blue-600\"><path d=\"M22 11.08V12a10 10 0 1 1-5.93-9.14\"></path><path d=\"m9 11 3 3L22 4\"></path></svg><span>Chen Jian, Chief Physician, Master Supervisor</span></div><div class=\"flex items-center gap-2 text-sm text-gray-600\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-check-circle text-blue-600\"><path d=\"M22 11.08V12a10 10 0 1 1-5.93-9.14\"></path><path d=\"m9 11 3 3L22 4\"></path></svg><span>Gao Jing, Associate Chief Physician</span></div></div></div></div><div class=\"bg-white rounded-2xl p-8 shadow-sm\" style=\"opacity: 0; transform: translateY(20px);\"><h3 class=\"text-2xl font-bold text-[#1A1A2E] mb-6 pb-4 border-b border-gray-200\">Abdominal-Pelvic / Breast Oncology</h3><div class=\"grid md:grid-cols-2 gap-6 mb-6\"><div class=\"bg-blue-50 rounded-xl p-6\"><div class=\"mb-4 fle